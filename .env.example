# Server only. Copy to .env; never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts

PORT=3000
# Set the public HTTPS origin for a production Node deployment.
APP_ORIGIN=
# Set to 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional private invitation: generate with openssl rand -hex 24.
TRIP_ACCESS_TOKEN=
# Set a separate strong password to enable admin history.
STATS_ADMIN_PASSWORD=
STATS_RETENTION_DAYS=30
STATS_DB_PATH=./data/stats.sqlite

# Explicit opt-in only. Example: https://ntfy.sh/dode-graikija
# Public topics expose excerpts to anyone who knows the topic name.
NTFY_TOPIC_URL=
NTFY_TOKEN=
NTFY_DELIVERY=server
